# ============================================================
# hundekuchenlive.de – Apache (IONOS)
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

ErrorDocument 404 /404.php

# Sensible Dateien nie direkt ausliefern
<FilesMatch "^(config(\.local)?\.php(\.example)?|setup-nextcloud\.php|\.env.*|\.gitignore|composer\.(json|lock)|README\.md|csrf\.php|rate-limit\.php)$">
    Require all denied
</FilesMatch>

# Sicherheits-Header
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=15552000"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.instant-gaming.com; style-src 'self' 'unsafe-inline' https://www.instant-gaming.com; img-src 'self' data: https:; font-src 'self' data: https://www.instant-gaming.com; connect-src 'self' https://www.instant-gaming.com; frame-src 'self' https://player.twitch.tv https://www.instant-gaming.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 365 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
</IfModule>

RewriteEngine On

# .git, Bibliotheken und PHP-Bausteine nie per HTTP ausliefern
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^PHPMailer(/|$) - [R=404,L]
RewriteRule ^components/.*\.php$ - [R=404,L]

# HTTP -> HTTPS (nicht lokal / im Heimnetz)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.) [NC]
RewriteRule ^ https://hundekuchenlive.de%{REQUEST_URI} [R=301,L]

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.hundekuchenlive\.de$ [NC]
RewriteRule ^ https://hundekuchenlive.de%{REQUEST_URI} [R=301,L]

# /index.html, /index.php, /about/index.php -> Ordner-URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(html|php)[\s?] [NC]
RewriteRule ^(.*/)?index\.(html|php)$ /$1 [R=301,L]

# Trailing Slash für echte Ordner
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ $1/ [R=301,L]
